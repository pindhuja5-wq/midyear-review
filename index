            document.querySelectorAll('.content-pane').forEach(pane => pane.classList.remove('active'));
            document.getElementById('pane-' + paneIndex).classList.add('active');

            const headings = [
                { title: '01. PRODUCTIVITY & SCORECARD TELEMETRY', sub: 'Month-by-month Volume & Efficiency Breakdown' },
                { title: '02. QUALITY & PRECISION CURVE', sub: 'Accuracy Compliance Across High-Volume Cycles' },
