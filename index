        .metric-value {
            font-family: var(--font-head);
            font-size: 1.6rem;
            color: var(--text-bright);
            font-weight: 700;
        }

        .data-table-wrapper {
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid var(--border-glow);
            border-radius: 16px;
            overflow: hidden;
            margin-top: 1.5rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            text-align: left;
        }

        th, td {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-glow);
        }

        th {
            background: rgba(56, 189, 248, 0.08);
            color: var(--text-bright);
            font-family: var(--font-head);
            font-size: 0.72rem;
            letter-spacing: 1px;
        }

        tr:hover td {
            background: rgba(56, 189, 248, 0.04);
        }

        .script-timeline {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .timeline-node {
            background: rgba(255, 255, 255, 0.02);
            border-left: 3px solid var(--accent-cyan);
            border-top: 1px solid var(--border-glow);
            border-right: 1px solid var(--border-glow);
            border-bottom: 1px solid var(--border-glow);
            padding: 1.5rem;
            border-radius: 0 16px 16px 0;
            position: relative;
        }

        .timeline-node h4 {
            font-family: var(--font-head);
            font-size: 0.85rem;
            color: var(--accent-amber);
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
        }

        .timeline-node p, .timeline-node li {
            font-family: var(--font-body);
            font-size: 0.9rem;
            line-height: 1.6;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }

        .timeline-node ul {
            list-style: none;
            margin-top: 0.8rem;
        }

        .timeline-node li::before {
            content: "▸ ";
            color: var(--accent-cyan);
        }

        /* Holographic Modal */
        .holo-modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(16px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 2rem;
        }

        .holo-modal-overlay.open { display: flex; }

        .holo-modal-container {
            background: var(--glass-panel);
            border: 1px solid var(--accent-cyan);
            width: 100%;
            max-width: 900px;
            border-radius: 24px;
            box-shadow: 0 0 80px rgba(56, 189, 248, 0.3);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 85vh;
        }

        .holo-modal-header {
            background: rgba(3, 7, 18, 0.95);
            border-bottom: 1px solid var(--border-glow);
            padding: 1.5rem 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .holo-modal-title {
            font-family: var(--font-head);
            font-size: 0.9rem;
            color: var(--accent-cyan);
            letter-spacing: 2px;
        }

        .holo-modal-close {
            background: transparent;
            border: none;
            color: var(--text-bright);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .holo-modal-body {
            padding: 2.5rem;
            overflow-y: auto;
            font-family: var(--font-body);
            line-height: 1.7;
        }
    </style>
</head>
