                { title: '05. MIND MAGIC CREW (MMC) IMPACT', sub: 'Committee Leadership & Wellness Installations' }
            ];

            document.getElementById('pane-heading').innerText = headings[paneIndex].title;
            document.getElementById('pane-subheading').innerText = headings[paneIndex].sub;
        }

        function openHoloModal() {
            document.getElementById('holoModal').classList.add('open');
        }

        function closeHoloModal() {
            document.getElementById('holoModal').classList.remove('open');
        }

        function toggleHoloTheme() {
            const body = document.body;
            body.setAttribute('data-theme', body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        }
    </script>
