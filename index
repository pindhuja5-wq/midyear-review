            --accent-violet: #8b5cf6;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --text-main: #94a3b8;
            --text-bright: #f8fafc;
            --font-head: 'Syncopate', sans-serif;
            --font-body: 'Space Grotesk', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --transition-fluid: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        [data-theme="light"] {
            --bg-obsidian: #f1f5f9;
            --glass-panel: rgba(255, 255, 255, 0.85);
            --border-glow: rgba(14, 165, 233, 0.25);
            --border-active: rgba(14, 165, 233, 0.9);
            --accent-cyan: #0284c7;
            --accent-violet: #7c3aed;
            --accent-emerald: #059669;
            --accent-amber: #d97706;
            --text-main: #475569;
            --text-bright: #0f172a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-body);
        }

        body {
            background-color: var(--bg-obsidian);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(56, 189, 248, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.06) 0%, transparent 40%),
                linear-gradient(to right, rgba(255,255,255,0.01) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.01) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            color: var(--text-main);
            padding: 2rem;
            min-height: 100vh;
            overflow-x: hidden;
            transition: var(--transition-fluid);
        }

        .deck-container {
            max-width: 1500px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 2rem;
        }

        @media (max-width: 1200px) {
            .deck-container { grid-template-columns: 1fr; }
        }

        /* Sidebar Navigation Deck */
        .sidebar-deck {
            background: var(--glass-panel);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-glow);
            border-radius: 24px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            height: fit-content;
        }

        .brand-header h1 {
            font-family: var(--font-head);
            font-size: 0.95rem;
            color: var(--text-bright);
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 0.3rem;
        }

        .brand-header p {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--accent-emerald);
        }

        .nav-modules {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .nav-pill {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-glow);
            padding: 1rem 1.2rem;
            border-radius: 14px;
            cursor: pointer;
            transition: var(--transition-fluid);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-pill:hover, .nav-pill.active {
            background: rgba(56, 189, 248, 0.1);
            border-color: var(--accent-cyan);
            transform: translateX(6px);
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.2);
        }

        .nav-pill-title {
            font-family: var(--font-head);
            font-size: 0.68rem;
            color: var(--text-bright);
            font-weight: 700;
        }

        .nav-pill-code {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--accent-cyan);
        }

        .sidebar-actions {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid var(--border-glow);
        }

        .action-btn {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(139, 92, 246, 0.1));
            border: 1px solid var(--border-glow);
            color: var(--text-bright);
            padding: 0.9rem;
            border-radius: 12px;
            font-family: var(--font-head);
            font-size: 0.68rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition-fluid);
            text-align: center;
            letter-spacing: 1px;
        }

        .action-btn:hover {
            background: var(--accent-cyan);
            color: #000;
            border-color: var(--accent-cyan);
            box-shadow: 0 0 30px var(--accent-cyan);
        }

        /* Main Holographic Workspace */
        .workspace-stage {
            background: var(--glass-panel);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-glow);
            border-radius: 24px;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            position: relative;
            min-height: 700px;
        }

        .stage-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid var(--border-glow);
            padding-bottom: 1.5rem;
        }

        .stage-title-group h2 {
            font-family: var(--font-head);
            font-size: 1.4rem;
            color: var(--text-bright);
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .stage-title-group p {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--accent-violet);
        }

        .live-badge {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid var(--accent-emerald);
            color: var(--accent-emerald);
            padding: 0.4rem 0.9rem;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pulsing-dot {
            width: 8px; height: 8px;
            background: var(--accent-emerald);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent-emerald);
            animation: pulseGlow 1.5s infinite;
        }

        @keyframes pulseGlow {
            0% { transform: scale(0.9); opacity: 0.7; }
            50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 15px var(--accent-emerald); }
            100% { transform: scale(0.9); opacity: 0.7; }
        }

        /* Dynamic Content Panes */
        .content-pane {
            display: none;
            animation: paneFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .content-pane.active { display: block; }

        @keyframes paneFadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Grid Cards & Tables */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .metric-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-glow);
            border-radius: 16px;
            padding: 1.5rem;
            transition: var(--transition-fluid);
        }

        .metric-card:hover {
            border-color: var(--accent-cyan);
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(56, 189, 248, 0.15);
        }

        .metric-label {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
